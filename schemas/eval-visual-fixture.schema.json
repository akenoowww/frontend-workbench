{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akenoowww/frontend-workbench/schemas/eval-visual-fixture.schema.json",
  "title": "Frontend Workbench visual eval fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "provenance", "brief", "captureMatrix"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "fixtureId": {
      "$ref": "deliverable-coverage.schema.json#/$defs/id"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceId",
        "sourceVersion",
        "evidenceBasis",
        "referenceScreenshotsAvailable",
        "limitations"
      ],
      "properties": {
        "sourceKind": {
          "const": "synthetic-fictional-eval-spec"
        },
        "sourceId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]+$"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1
        },
        "evidenceBasis": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "declared-product-intent",
              "declared-project-dna",
              "declared-interaction-contract",
              "declared-content-truth"
            ]
          }
        },
        "referenceScreenshotsAvailable": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productIntent",
        "userJobs",
        "protectedCapabilities",
        "contentTruth",
        "projectDna",
        "avoid"
      ],
      "properties": {
        "productIntent": {
          "type": "string",
          "minLength": 20
        },
        "userJobs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "protectedCapabilities": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "contentTruth": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "projectDna": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typographyRoles",
            "colorRoles",
            "spacingAndShape",
            "componentPosture",
            "imageryRole",
            "motionTone"
          ],
          "properties": {
            "typographyRoles": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "colorRoles": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "spacingAndShape": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "componentPosture": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "imageryRole": {
              "$ref": "#/$defs/nonEmptyStringArray"
            },
            "motionTone": {
              "$ref": "#/$defs/nonEmptyStringArray"
            }
          }
        },
        "evaluationContext": {
          "$ref": "#/$defs/evaluationContext"
        },
        "avoid": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "captureMatrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/captureTarget"
      }
    }
  },
  "$defs": {
    "evaluationContext": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "productHierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primaryObject",
            "supportingObjects",
            "executionMechanisms",
            "invariant"
          ],
          "properties": {
            "primaryObject": {"type": "string", "minLength": 2},
            "supportingObjects": {"$ref": "#/$defs/nonEmptyStringArray"},
            "executionMechanisms": {"$ref": "#/$defs/nonEmptyStringArray"},
            "invariant": {"type": "string", "minLength": 20}
          }
        },
        "shellContinuity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedAnchorId", "invariants"],
          "properties": {
            "acceptedAnchorId": {
              "$ref": "deliverable-coverage.schema.json#/$defs/id"
            },
            "invariants": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/scopedReference"}
        },
        "capabilityFit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capability",
            "establishedOptions",
            "comparisonRequired",
            "customPrimitiveAllowedWhen",
            "requiredFallbacks"
          ],
          "properties": {
            "capability": {"type": "string", "minLength": 10},
            "establishedOptions": {"$ref": "#/$defs/nonEmptyStringArray"},
            "comparisonRequired": {"const": true},
            "customPrimitiveAllowedWhen": {
              "type": "string",
              "minLength": 20
            },
            "requiredFallbacks": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "implementationScope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorizedSurfaceIds", "forbiddenChanges"],
          "properties": {
            "authorizedSurfaceIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "deliverable-coverage.schema.json#/$defs/id"
              }
            },
            "forbiddenChanges": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "operationalMetadataPolicy": {
          "$ref": "deliverable-coverage.schema.json#/properties/operationalMetadataPolicy"
        },
        "redesignBoundary": {
          "$ref": "visual-direction-contract.schema.json#/$defs/redesignBoundary"
        },
        "contentDistribution": {
          "$ref": "visual-direction-contract.schema.json#/$defs/contentDistribution"
        }
      }
    },
    "scopedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "scope",
        "allowedInfluence",
        "forbiddenInfluence"
      ],
      "properties": {
        "id": {"$ref": "deliverable-coverage.schema.json#/$defs/id"},
        "role": {
          "enum": [
            "FUNCTIONAL_REFERENCE",
            "STYLE_REFERENCE",
            "VISUAL_ANCHOR",
            "EDIT_TARGET"
          ]
        },
        "scope": {"type": "string", "minLength": 10},
        "allowedInfluence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "forbiddenInfluence": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "captureTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureId",
        "outputId",
        "surfaceId",
        "route",
        "state",
        "viewport",
        "scrollPosition"
      ],
      "properties": {
        "captureId": {
          "$ref": "deliverable-coverage.schema.json#/$defs/id"
        },
        "outputId": {
          "$ref": "deliverable-coverage.schema.json#/$defs/id"
        },
        "surfaceId": {
          "$ref": "deliverable-coverage.schema.json#/$defs/id"
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "width", "height"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 7680
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 7680
            }
          }
        },
        "scrollPosition": {
          "enum": ["top", "viewport", "full-page"]
        }
      }
    }
  }
}
