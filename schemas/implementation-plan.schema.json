{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akenoowww/frontend-workbench/schemas/implementation-plan.schema.json",
  "title": "Frontend Workbench implementation capability plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "contractSha256",
    "structureSha256",
    "capabilityDecisions",
    "targetBindings",
    "outputBindings"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contractId": {"$ref": "deliverable-coverage.schema.json#/$defs/id"},
    "contractSha256": {"$ref": "#/$defs/sha256"},
    "structureSha256": {"$ref": "#/$defs/sha256"},
    "capabilityDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirementId",
          "selectedApproach",
          "existingOwner",
          "candidates",
          "selectedCandidate",
          "gap",
          "lifetimeRationale",
          "obligations",
          "validation"
        ],
        "properties": {
          "requirementId": {"$ref": "deliverable-coverage.schema.json#/$defs/id"},
          "decisionTier": {
            "enum": ["direct", "known-fit", "comparative"]
          },
          "selectedApproach": {
            "enum": [
              "reuse",
              "extend",
              "compose",
              "platform",
              "framework",
              "external-dependency",
              "project-owned"
            ]
          },
          "existingOwner": {"type": ["string", "null"], "minLength": 1},
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "evidenceRef", "evidenceSha256"],
              "properties": {
                "name": {"type": "string", "minLength": 3},
                "kind": {
                  "enum": [
                    "reuse",
                    "extend",
                    "compose",
                    "platform",
                    "framework",
                    "external-dependency",
                    "project-owned",
                    "project-file",
                    "existing-owner",
                    "native"
                  ]
                },
                "evidenceRef": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^repo:[A-Za-z0-9][A-Za-z0-9._/-]*$"
                    },
                    {
                      "type": "string",
                      "pattern": "^session:implementation/evidence/[A-Za-z0-9][A-Za-z0-9._/-]*$"
                    }
                  ]
                },
                "evidenceSha256": {"$ref": "#/$defs/sha256"}
              }
            }
          },
          "selectedCandidate": {"type": "string", "minLength": 1},
          "gap": {"type": "string", "minLength": 12},
          "lifetimeRationale": {"type": "string", "minLength": 16},
          "obligations": {"$ref": "#/$defs/nonEmptyStringArrayAllowEmpty"},
          "validation": {"$ref": "#/$defs/nonEmptyStringArray"}
        }
      }
    },
    "targetBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "surfaceIds", "capabilityRequirementIds"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "surfaceIds": {"$ref": "#/$defs/idArray"},
          "capabilityRequirementIds": {"$ref": "#/$defs/idArray"}
        }
      }
    },
    "outputBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["outputId", "targetPaths", "capabilityRequirementIds"],
        "properties": {
          "outputId": {"$ref": "deliverable-coverage.schema.json#/$defs/id"},
          "targetPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "capabilityRequirementIds": {"$ref": "#/$defs/idArray"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "deliverable-coverage.schema.json#/$defs/id"}
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    },
    "nonEmptyStringArrayAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    }
  }
}
