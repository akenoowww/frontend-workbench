{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akenoowww/frontend-workbench/schemas/render-brief.schema.json",
  "title": "Frontend Workbench bound ImageGen render brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outputId",
    "visualDirectionSha256",
    "shellIds",
    "referenceBindingIds",
    "anchorOutputId",
    "anchorArtifactSha256",
    "preserve",
    "changeOnly"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "outputId": {"$ref": "deliverable-coverage.schema.json#/$defs/id"},
    "visualDirectionSha256": {"$ref": "#/$defs/sha256"},
    "shellIds": {"$ref": "#/$defs/idArrayAllowEmpty"},
    "referenceBindingIds": {"$ref": "#/$defs/idArrayAllowEmpty"},
    "anchorOutputId": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "deliverable-coverage.schema.json#/$defs/id"}
      ]
    },
    "anchorArtifactSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "preserve": {"$ref": "#/$defs/instructionArray"},
    "changeOnly": {"$ref": "#/$defs/instructionArray"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"anchorOutputId": {"type": "null"}},
        "required": ["anchorOutputId"]
      },
      "then": {
        "properties": {"anchorArtifactSha256": {"type": "null"}}
      },
      "else": {
        "properties": {
          "anchorArtifactSha256": {"$ref": "#/$defs/sha256"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idArrayAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "deliverable-coverage.schema.json#/$defs/id"}
    },
    "instructionArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 8}
    }
  }
}
